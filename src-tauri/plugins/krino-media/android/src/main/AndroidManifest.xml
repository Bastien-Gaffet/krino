<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Autorise le trafic HTTP en clair vers 127.0.0.1/localhost — requis
         par le petit serveur vidéo local (VideoServer.kt), bloqué par
         défaut depuis Android 9 sinon (voir res/xml/network_security_config.xml).
         Fusionné dans le <application> final de l'app par le manifest merger
         d'Android (une lib ne déclare normalement pas ses propres fenêtres,
         mais peut contribuer des attributs comme celui-ci). -->
    <application android:networkSecurityConfig="@xml/network_security_config" />

    <!-- Lecture de la photothèque. Ces permissions sont « sensibles » au sens
         de Google Play : la gestion de photos devant être la fonction
         principale de l'application, un formulaire de déclaration sera à
         remplir lors de la publication (voir docs/MOBILE.md). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <!-- Android 14+ : l'utilisateur peut n'accorder l'accès qu'à une sélection
         de photos. Déclarer cette permission permet de détecter ce cas plutôt
         que de le confondre avec un refus. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <!-- Android 11-12 (minSdk 30) : READ_MEDIA_IMAGES/VIDEO n'existent pas
         encore, il faut l'ancienne permission de stockage. maxSdkVersion=32
         évite de la redemander sur un appareil qui a déjà les permissions
         granulaires. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

</manifest>
